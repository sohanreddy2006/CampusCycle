# Copy this file to application.properties and fill in local values.
#   cp application.properties.example application.properties
#
# The real application.properties is intentionally gitignored because it
# contains local secrets. Prefer environment variables for anything sensitive
# (see README.md section 6): SPRING_DATASOURCE_USERNAME,
# SPRING_DATASOURCE_PASSWORD, APP_JWT_SECRET, APP_JWT_EXPIRATION_MS,
# APP_UNIVERSITY_EMAIL_DOMAIN.

server.port=5000

# MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/campuscycle?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=<your-mysql-user>
spring.datasource.password=<your-mysql-password>
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# JWT
app.jwt.secret=<generate-a-long-random-secret>
app.jwt.expiration-ms=604800000

# University email gate
app.university.email-domain=@anurag.edu.in

logging.level.com.campuscycle=INFO
